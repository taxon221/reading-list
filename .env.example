AUTH_MODE=app
BOOTSTRAP_ADMIN_EMAIL=you@example.com
APP_PUBLIC_URL=https://reading-list.example.com
RSS_ALLOW_PRIVATE_HOSTS=false
# Set to true only when a reverse proxy or tunnel sits in front of the app, so
# sign-in rate limits use the real client address (CF-Connecting-IP / X-Forwarded-For).
TRUST_PROXY=false
# Switch AUTH_MODE to cloudflare and set these when deploying behind Cloudflare Access:
# CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# CLOUDFLARE_ACCESS_AUD=your-access-audience

# Local development only: AUTH_MODE=local and LOCAL_DEV_AUTH_EMAIL=you@example.com
# New saves capture a clean article copy by default; disable with ARTICLE_CAPTURE_ON_SAVE=false.
